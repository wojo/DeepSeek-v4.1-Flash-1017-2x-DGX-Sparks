+/// What `Caches.layout` hands out in a first pass: it records each tensor's size and gives no address.
+pub const Sizer = struct {
+    sizes: [max_tensors]usize = undefined,
+    n: usize = 0,
+    pub const max_tensors = 512;
+    pub fn take(s: *Sizer, bytes: usize) !u64 {
+        if (s.n == max_tensors) return error.DisplayTooManyTensors;
+        s.sizes[s.n] = bytes;
+        s.n += 1;
+        return 0;
+    }
+};
+
+/// What `Caches.layout` hands out in the second pass: the span's tensors at their placed offsets, in the order the first pass saw them.
+pub const Offsets = struct {
+    base: u64,
+    offs: []const usize,
+    at: usize = 0,
+    pub fn take(o: *Offsets, bytes: usize) !u64 {
+        _ = bytes;
+        if (o.at == o.offs.len) return error.DisplayLayoutChanged;
+        defer o.at += 1;
+        return o.base + o.offs[o.at];
+    }
+};
+
+test "sizer then offsets: the second pass hands out the placed addresses in the first pass's order" {
+    var sz: Sizer = .{};
+    for ([_]usize{ 300, 70000, 5 }) |n| try std.testing.expectEqual(@as(u64, 0), try sz.take(n));
+    var offs: [3]usize = undefined;
+    const p = try place(&offs, sz.sizes[0..sz.n], 1 << 20);
+    var o: Offsets = .{ .base = 0x1000, .offs = &offs };
+    for (offs) |want| try std.testing.expectEqual(0x1000 + want, try o.take(0));
+    try std.testing.expectError(error.DisplayLayoutChanged, o.take(0));
+    try std.testing.expect(p.total >= offs[2] + 5);
+}
+
+test "one framebuffer a process: a second claim is refused until the span that holds it is released" {
+    try std.testing.expect(tryClaim());
+    try std.testing.expect(!tryClaim());
+    var span: Span = .{ .ptr = 0, .d = undefined, .owns_claim = true };
+    span.deinit();
+    try std.testing.expect(tryClaim());
+    releaseClaim();
+}
