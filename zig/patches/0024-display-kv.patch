+test "display KV with the shard: each rank's owner planes go on the framebuffer first, the rest on host pages; replicated as the arena orders them" {
+    const display = @import("display.zig");
+    var why: @import("config.zig").Why = .{};
+    const c = try @import("config.zig").parse(std.testing.allocator, @import("config.zig").test_config, &why);
+    var layers: [64]weights.Layer = undefined;
+    var w: weights.Weights = .{ .gpa = std.testing.allocator };
+    const e = shapeEngine(&c, &w, layers[0..c.layers]);
+    const budget: usize = 1792 << 20; // a headless GB10's reservation, as the recipe's examples ask
+    const ncomp = Caches.compTensors(&e);
+    try std.testing.expectEqual(@as(usize, 8), ncomp); // 4 kv sources' codes and scales
+    for ([_]usize{ 2_101_248, 4_202_496, 8_404_992 }) |pool| {
+        for (0..2) |rank| {
+            const sh = try shard.Shard.init(@intCast(rank), 2, pool, 48);
+            var sz: display.Sizer = .{};
+            const sized = try Caches.layout(&e, &sz, pool, 8, sh, .owner_last);
+            var offs: [display.Sizer.max_tensors]usize = undefined;
+            const p = try display.place(offs[0..sz.n], sz.sizes[0..sz.n], budget);
+            const s = display.split(offs[0..sz.n], sz.sizes[0..sz.n], p, sz.n - ncomp);
+            try std.testing.expect(p.display <= budget and s.display > 0);
+            try std.testing.expectEqual(s.total, s.display + s.ordinary);
+            // the owner planes: this rank's part's rows only (planeRows), every one of them sized
+            var owner: usize = 0;
+            for (e.w.layers) |lay| if (lay.comp_wkv != null) {
+                owner += sh.planeRows(lay.ratio) * (c.head_dim / 2 + c.head_dim / 16);
+            };
+            try std.testing.expectEqual(owner, s.owner);
+            if (s.owner + display.page <= budget) {
+                // they all fit: every owner byte on the framebuffer, the room left to the last index keys and raw stores
+                try std.testing.expectEqual(s.owner, s.owner_display);
+            } else {
+                // they do not: the framebuffer holds owner planes only, nothing else displaced them
+                try std.testing.expectEqual(s.display, s.owner_display);
+            }
+            // the second pass: the placed addresses, the same tensors, no tensor across the two halves
+            var at: display.Offsets = .{ .base = 1 << 40, .offs = offs[0..sz.n] };
+            const cs = try Caches.layout(&e, &at, pool, 8, sh, .owner_last);
+            try std.testing.expectEqual(sz.n, at.at);
+            try std.testing.expectEqual(sized.shard.?.part, cs.shard.?.part);
+            for (e.w.layers, 0..) |lay, i| if (lay.comp_wkv != null) {
+                const o = cs.comp_codes[i] - (1 << 40);
+                if (s.owner_display == s.owner) try std.testing.expect(o >= p.ordinary);
+            };
+            for (offs[0..sz.n], sz.sizes[0..sz.n]) |o, n| try std.testing.expect(o + n <= p.ordinary or o >= p.ordinary);
+        }
+    }
+    // the 4M pool: 1,442 MiB of owner planes a rank fit a 1792 MiB reservation whole
+    {
+        const sh = try shard.Shard.init(0, 2, 4_202_496, 48);
+        var sz: display.Sizer = .{};
+        _ = try Caches.layout(&e, &sz, 4_202_496, 8, sh, .owner_last);
+        var offs: [display.Sizer.max_tensors]usize = undefined;
+        const p = try display.place(offs[0..sz.n], sz.sizes[0..sz.n], budget);
+        const s = display.split(offs[0..sz.n], sz.sizes[0..sz.n], p, sz.n - ncomp);
+        try std.testing.expectEqual(s.owner, s.owner_display);
+        try std.testing.expectEqual(@as(usize, 1442), s.owner >> 20);
+    }
+    // replicated: the arena's order (layer by layer), the same tensors as the arena takes
+    {
+        var sz: display.Sizer = .{};
+        _ = try Caches.layout(&e, &sz, 1_048_576, 8, null, .layers);
+        var ar: display.Sizer = .{};
+        _ = try Caches.layout(&e, &ar, 1_048_576, 8, null, .owner_last);
+        try std.testing.expectEqual(sz.n, ar.n);
+        try std.testing.expectEqual(sz.sizes[0], c.head_dim / 2 * (1_048_576 / 2 + 2)); // layer 2's codes first
+    }
+    // a shard of another pool is refused
+    var bad: display.Sizer = .{};
+    try std.testing.expectError(error.BadShard, Caches.layout(&e, &bad, 1_048_576, 8, try shard.Shard.init(0, 2, 2_101_248, 48), .owner_last));
+}
