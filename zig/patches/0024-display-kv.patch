@@ -0,0 +1,463 @@
+//! Display-reserve KV (TF_DS_DISPLAY_KV_MIB): the headless GB10's UEFI framebuffer reservation (about 1.75 GiB a GPU) carries part of the
+//! device KV pool, so those bytes leave the host's MemAvailable. Ported from MiaAI-Lab's TensorFold GLM engine (glm_cuda/cuda_display_kv.zig,
+//! TensorFold by Ash Hart and contributors), DRM backend only: a DRM dumb buffer mapped above the ordinary half of one span, each half
+//! registered with cuMemHostRegister, one contiguous device range. Every tensor lies wholly on one half, so no copy or fill ever has to cross
+//! the driver's registration boundary.
+const std = @import("std");
+const cuda = @import("cuda");
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+}
+
+/// MiB of the framebuffer to use: whole 16 MiB steps, at most 2032 (the reservation is 2 GiB less the driver's tail); unset or blank is 0 (off).
+pub fn mib(raw: ?[]const u8) !usize {
+    const t = std.mem.trim(u8, raw orelse "", " \t\r\n");
+    if (t.len == 0) return 0;
+    const n = std.fmt.parseInt(i64, t, 10) catch return error.InvalidDisplayMiB;
+    if (n < 0 or n > 2032 or @mod(n, 16) != 0) return error.InvalidDisplayMiB;
+    return @intCast(n);
+}
+
+pub const Config = struct {
+    bytes: usize = 0,
+    card: []const u8 = "/dev/dri/card0",
+
+    pub fn parse(size: ?[]const u8, card: ?[]const u8) !Config {
+        return .{ .bytes = (try mib(size)) << 20, .card = card orelse "/dev/dri/card0" };
+    }
+
+    /// TF_DS_DISPLAY_KV_MIB and TF_DS_DISPLAY_KV_CARD.
+    pub fn read() !Config {
+        return parse(env("TF_DS_DISPLAY_KV_MIB"), env("TF_DS_DISPLAY_KV_CARD"));
+    }
+};
+
+/// The framebuffer is only free to borrow with no display attached: any connected output on the card refuses.
+pub fn headless(gpa: std.mem.Allocator, io: std.Io, sysfs: []const u8, card_path: []const u8) !void {
+    var dir = try std.Io.Dir.cwd().openDir(io, sysfs, .{ .iterate = true });
+    defer dir.close(io);
+    const prefix = try std.fmt.allocPrint(gpa, "{s}-", .{std.fs.path.basename(card_path)});
+    defer gpa.free(prefix);
+    var it = dir.iterate();
+    while (try it.next(io)) |entry| {
+        if (!std.mem.startsWith(u8, entry.name, prefix)) continue;
+        const path = try std.fmt.allocPrint(gpa, "{s}/status", .{entry.name});
+        defer gpa.free(path);
+        var f = try dir.openFile(io, path, .{});
+        defer f.close(io);
+        var buf: [128]u8 = undefined;
+        var r = f.readerStreaming(io, &buf);
+        const text = try r.interface.allocRemaining(gpa, .limited(128));
+        defer gpa.free(text);
+        if (std.mem.eql(u8, std.mem.trim(u8, text, " \t\r\n"), "connected")) return error.DisplayConnected;
+    }
+}
+
+/// The kernel's page (GB10's arm64 kernel runs 64 KiB pages): the display half of the span is mapped at a page boundary.
+pub const page: usize = 64 << 10;
+/// Device pointers the kernels get are 256-byte aligned, as cuMemAlloc hands them out.
+const buffer_align: usize = 256;
+
+/// How one span holds every tensor: `ordinary` bytes of host pages then `display` bytes on the framebuffer (both whole 64 KiB pages).
+pub const Plan = struct { total: usize, ordinary: usize, display: usize };
+
+/// Packs `sizes` into offsets `offs[i]` of one span, 256-byte aligned and in order, and puts the last tensors, as many as fit in `budget` bytes
+/// of the framebuffer, on its top half. A tensor never straddles the two halves (the driver refuses a copy or a memset across two
+/// cuMemHostRegister ranges), so the boundary falls between two tensors, at a page; the tensors above it are shifted up to it.
+pub fn place(offs: []usize, sizes: []const usize, budget: usize) !Plan {
+    std.debug.assert(offs.len == sizes.len);
+    var at: usize = 0;
+    for (sizes, offs) |n, *o| {
+        o.* = at;
+        at = std.math.add(usize, at, std.mem.alignForward(usize, n, buffer_align)) catch return error.DisplayTooLarge;
+    }
+    // the first tensor on the framebuffer: the tail whose bytes fit in the budget less a page (the boundary's rounding up to a page takes
+    // at most that much of it back)
+    const room = budget -| page;
+    var first = sizes.len;
+    var shown: usize = 0;
+    while (first > 0) {
+        const n = std.mem.alignForward(usize, sizes[first - 1], buffer_align);
+        if (shown + n > room) break;
+        shown += n;
+        first -= 1;
+    }
+    if (first == sizes.len) return .{ .total = std.mem.alignForward(usize, at, page), .ordinary = std.mem.alignForward(usize, at, page), .display = 0 };
+    const start = offs[first];
+    const boundary = std.mem.alignForward(usize, start, page);
+    for (offs[first..]) |*o| o.* = o.* - start + boundary;
+    const total = std.mem.alignForward(usize, boundary + shown, page);
+    return .{ .total = total, .ordinary = boundary, .display = total - boundary };
+}
+
+/// What a placement put where, in tensor bytes (no alignment padding): every tensor, those on the framebuffer half and
+/// those on host pages, and of the tensors from `owner_from` on (TF_DS_KV_SHARD's owner planes, layout's last ones)
+/// all and those on the framebuffer. For the start-up's note.
+pub const Split = struct { total: usize = 0, display: usize = 0, ordinary: usize = 0, owner: usize = 0, owner_display: usize = 0 };
+
+pub fn split(offs: []const usize, sizes: []const usize, p: Plan, owner_from: usize) Split {
+    std.debug.assert(offs.len == sizes.len and owner_from <= sizes.len);
+    var s: Split = .{};
+    for (offs, sizes, 0..) |o, n, i| {
+        const shown = p.display > 0 and o >= p.ordinary;
+        s.total += n;
+        if (shown) s.display += n else s.ordinary += n;
+        if (i >= owner_from) {
+            s.owner += n;
+            if (shown) s.owner_display += n;
+        }
+    }
+    return s;
+}
+
+extern "c" fn mmap(?*anyopaque, usize, c_int, c_int, c_int, i64) ?*anyopaque;
+extern "c" fn munmap(?*anyopaque, usize) c_int;
+extern "c" fn ioctl(c_int, c_ulong, ...) c_int;
+extern "c" fn open([*:0]const u8, c_int, ...) c_int;
+
+/// One mapped span: ordinary host pages below, the framebuffer's dumb buffer above, each its own cuMemHostRegister range, one contiguous
+/// device range from `ptr`.
+pub const Span = struct {
+    /// the device address of the span's first byte
+    ptr: u64,
+    base: usize = 0,
+    ordinary: usize = 0,
+    display: usize = 0,
+    fd: c_int = -1,
+    handle: u32 = 0,
+    ordinary_registered: bool = false,
+    display_registered: bool = false,
+    d: *const cuda.Driver,
+    /// set by map(): this span holds the process's one framebuffer claim
+    owns_claim: bool = false,
+
+    pub fn deinit(s: *Span) void {
+        defer if (s.owns_claim) {
+            releaseClaim();
+            s.owns_claim = false;
+        };
+        if (s.base == 0) return;
+        if (s.display_registered) _ = s.d.api.cuMemHostUnregister(@ptrFromInt(s.base + s.ordinary));
+        if (s.ordinary_registered) _ = s.d.api.cuMemHostUnregister(@ptrFromInt(s.base));
+        _ = munmap(@ptrFromInt(s.base), s.ordinary + s.display);
+        var close_gem = [_]u32{ s.handle, 0 };
+        _ = ioctl(s.fd, 0x40086409, &close_gem); // DRM_IOCTL_GEM_CLOSE
+        _ = std.c.close(s.fd);
+        s.base = 0;
+    }
+};
+
+fn mapped(address: usize, size: usize, prot: c_int, flags: c_int, fd: c_int, offset: u64) !usize {
+    const p = mmap(if (address == 0) null else @ptrFromInt(address), size, prot, flags, fd, @intCast(offset)) orelse return error.DisplayMmap;
+    const at = @intFromPtr(p);
+    if (at == std.math.maxInt(usize) or (address != 0 and at != address)) return error.DisplayMmap;
+    return at;
+}
+
+var claimed: std.atomic.Value(bool) = .init(false);
+
+fn tryClaim() bool {
+    return claimed.cmpxchgStrong(false, true, .acq_rel, .acquire) == null;
+}
+
+fn releaseClaim() void {
+    claimed.store(false, .release);
+}
+
+/// Maps the plan's ordinary host pages and its framebuffer bytes as one registered span. One framebuffer a process.
+pub fn map(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, card_path: []const u8, p: Plan) !Span {
+    if (!tryClaim()) return error.DisplayAlreadyAllocated;
+    errdefer releaseClaim();
+    try headless(gpa, io, "/sys/class/drm", card_path);
+    const card = try gpa.dupeSentinel(u8, card_path, 0);
+    defer gpa.free(card);
+    var system: System = .{ .d = d, .card = card };
+    var span = try mapDrm(&system, p.ordinary, p.display);
+    span.owns_claim = true;
+    return span;
+}
+
+/// The real OS and driver calls (DRM_IOCTL_MODE_CREATE_DUMB 0xC02064B2, MODE_MAP_DUMB 0xC01064B3, GEM_CLOSE 0x40086409;
+/// cuMemHostRegister flags 2 = DEVICEMAP, 6 = DEVICEMAP | IOMEMORY).
+const System = struct {
+    d: *const cuda.Driver,
+    card: [:0]const u8,
+    fn openCard(s: *System) !c_int {
+        const fd = open(s.card, 2 | 0x80000); // O_RDWR | O_CLOEXEC
+        if (fd < 0) return error.DisplayCardUnavailable;
+        return fd;
+    }
+    fn create(_: *System, fd: c_int, size: usize) !struct { handle: u32, size: usize } {
+        var dumb: extern struct { height: u32, width: u32 = 4096, bpp: u32 = 32, flags: u32 = 0, handle: u32 = 0, pitch: u32 = 0, size: u64 = 0 } = .{ .height = @intCast(std.math.divCeil(usize, size, 4096 * 4) catch return error.DisplayCreateDumb) };
+        if (ioctl(fd, 0xC02064B2, &dumb) != 0) return error.DisplayCreateDumb;
+        return .{ .handle = dumb.handle, .size = @intCast(dumb.size) };
+    }
+    fn offset(_: *System, fd: c_int, handle: u32) !u64 {
+        var out: extern struct { handle: u32, pad: u32 = 0, offset: u64 = 0 } = .{ .handle = handle };
+        if (ioctl(fd, 0xC01064B3, &out) != 0) return error.DisplayMapDumb;
+        return out.offset;
+    }
+    fn reserve(_: *System, size: usize) !usize {
+        return mapped(0, size, 0, 0x4022, -1, 0); // PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE
+    }
+    fn ordinary(_: *System, base: usize, size: usize) !void {
+        _ = try mapped(base, size, 3, 0x32, -1, 0); // RW, MAP_PRIVATE | MAP_FIXED | MAP_ANONYMOUS
+    }
+    fn display(_: *System, base: usize, size: usize, fd: c_int, offset_value: u64) !void {
+        _ = try mapped(base, size, 3, 0x11, fd, offset_value); // RW, MAP_SHARED | MAP_FIXED
+    }
+    fn register(s: *System, base: usize, size: usize, is_io: bool) !void {
+        try s.d.check(s.d.api.cuMemHostRegister_v2(@ptrFromInt(base), size, if (is_io) 6 else 2), "display register");
+    }
+    fn pointer(s: *System, base: usize) !u64 {
+        var out: u64 = 0;
+        try s.d.check(s.d.api.cuMemHostGetDevicePointer_v2(&out, @ptrFromInt(base), 0), "display device pointer");
+        return out;
+    }
+    fn unregister(s: *System, base: usize) void {
+        _ = s.d.api.cuMemHostUnregister(@ptrFromInt(base));
+    }
+    fn unmap(_: *System, base: usize, size: usize) void {
+        _ = munmap(@ptrFromInt(base), size);
+    }
+    fn closeGem(_: *System, fd: c_int, handle: u32) void {
+        var gem = [_]u32{ handle, 0 };
+        _ = ioctl(fd, 0x40086409, &gem);
+    }
+    fn closeFd(_: *System, fd: c_int) void {
+        _ = std.c.close(fd);
+    }
+};
+
+/// The call seam the tests drive: every failure unwinds what the steps before it made.
+fn mapDrm(system: anytype, ordinary: usize, display_bytes: usize) !Span {
+    const fd = try system.openCard();
+    errdefer system.closeFd(fd);
+    const dumb = try system.create(fd, display_bytes);
+    errdefer system.closeGem(fd, dumb.handle);
+    if (dumb.size < display_bytes) return error.DisplayShort;
+    const offset = try system.offset(fd, dumb.handle);
+    const base = try system.reserve(ordinary + display_bytes);
+    errdefer system.unmap(base, ordinary + display_bytes);
+    if (ordinary > 0) try system.ordinary(base, ordinary);
+    try system.display(base + ordinary, display_bytes, fd, offset);
+    if (ordinary > 0) try system.register(base, ordinary, false);
+    errdefer if (ordinary > 0) system.unregister(base);
+    try system.register(base + ordinary, display_bytes, true);
+    errdefer system.unregister(base + ordinary);
+    const ptr = try system.pointer(base);
+    const top = try system.pointer(base + ordinary);
+    if (top < ptr or top - ptr != ordinary) return error.DisplayNotContiguous;
+    return .{ .ptr = ptr, .base = base, .ordinary = ordinary, .display = display_bytes, .fd = fd, .handle = dumb.handle, .d = system.d, .ordinary_registered = ordinary > 0, .display_registered = true };
+}
+
+test "display configuration: whole 16 MiB steps from 0 to 2032, anything else refused" {
+    try std.testing.expectEqual(@as(usize, 0), try mib(null));
+    try std.testing.expectEqual(@as(usize, 0), try mib("  "));
+    try std.testing.expectEqual(@as(usize, 1792), try mib(" 1792 "));
+    try std.testing.expectEqual(@as(usize, 2032), try mib("2032"));
+    for ([_][]const u8{ "-16", "1", "2048", "2033", "nan", "16.0", "0x10" }) |raw| try std.testing.expectError(error.InvalidDisplayMiB, mib(raw));
+}
+
+test "display config: unset is off with the default card, a size sets the bytes, a card path is kept" {
+    const off = try Config.parse(null, null);
+    try std.testing.expectEqual(@as(usize, 0), off.bytes);
+    try std.testing.expectEqualStrings("/dev/dri/card0", off.card);
+    const on = try Config.parse("1792", "/dev/dri/card1");
+    try std.testing.expectEqual(@as(usize, 1792 << 20), on.bytes);
+    try std.testing.expectEqualStrings("/dev/dri/card1", on.card);
+    try std.testing.expectError(error.InvalidDisplayMiB, Config.parse("1793", null));
+}
+
+test "a connected output on the configured card refuses display memory" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = std.testing.io;
+    try tmp.dir.createDir(io, "card0-HDMI-A-1", .default_dir);
+    try tmp.dir.createDir(io, "card1-DP-1", .default_dir);
+    try tmp.dir.writeFile(io, .{ .sub_path = "card0-HDMI-A-1/status", .data = "connected\n" });
+    try tmp.dir.writeFile(io, .{ .sub_path = "card1-DP-1/status", .data = "disconnected\n" });
+    const path = try std.fmt.allocPrint(std.testing.allocator, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer std.testing.allocator.free(path);
+    try std.testing.expectError(error.DisplayConnected, headless(std.testing.allocator, io, path, "/dev/dri/card0"));
+    try headless(std.testing.allocator, io, path, "/dev/dri/card1");
+    try tmp.dir.writeFile(io, .{ .sub_path = "card0-HDMI-A-1/status", .data = "disconnected\n" });
+    try headless(std.testing.allocator, io, path, "/dev/dri/card0");
+}
+
+test "place: tensors packed 256-byte aligned and in order, the boundary a page, no tensor across it" {
+    const sizes = [_]usize{ (3 << 20) + 100, 1 << 20, 0, 2 << 20, 5 << 20 };
+    var offs: [5]usize = undefined;
+    const p = try place(&offs, &sizes, 6 << 20);
+    for (offs) |o| try std.testing.expectEqual(@as(usize, 0), o % 256);
+    for (1..sizes.len) |i| try std.testing.expect(offs[i - 1] + sizes[i - 1] <= offs[i]);
+    try std.testing.expectEqual(@as(usize, 0), p.total % page);
+    try std.testing.expectEqual(@as(usize, 0), p.ordinary % page);
+    try std.testing.expectEqual(p.total, p.ordinary + p.display);
+    try std.testing.expect(p.total >= offs[4] + sizes[4]);
+    for (offs, sizes) |o, n| {
+        const end = o + n;
+        try std.testing.expect(end <= p.ordinary or o >= p.ordinary); // wholly on one half
+    }
+    try std.testing.expect(p.display <= 6 << 20);
+    try std.testing.expect(p.display >= 5 << 20); // the last tensor is on the framebuffer
+}
+
+test "place: the framebuffer half never exceeds the budget; all of it when the tensors fit; none when the budget is 0" {
+    const sizes = [_]usize{ 1 << 20, 1 << 20, 3 << 20 };
+    var offs: [3]usize = undefined;
+    const big = try place(&offs, &sizes, 1792 << 20);
+    try std.testing.expectEqual(@as(usize, 0), big.ordinary);
+    try std.testing.expectEqual(big.total, big.display);
+    try std.testing.expectEqual(@as(usize, 0), offs[0]);
+    const none = try place(&offs, &sizes, 0);
+    try std.testing.expectEqual(@as(usize, 0), none.display);
+    try std.testing.expectEqual(none.total, none.ordinary);
+    for (1..8) |k| {
+        const budget = k << 20;
+        const p = try place(&offs, &sizes, budget);
+        try std.testing.expect(p.display <= budget);
+        for (offs, sizes) |o, n| try std.testing.expect(o + n <= p.ordinary or o >= p.ordinary);
+    }
+}
+
+test "place: tensors that are bigger than the budget stay on host pages, in the same order and span size as without it" {
+    const sizes = [_]usize{ 4 << 20, 4 << 20 };
+    var offs: [2]usize = undefined;
+    const p = try place(&offs, &sizes, 2 << 20);
+    try std.testing.expectEqual(@as(usize, 0), p.display);
+    try std.testing.expectEqual(@as(usize, 4 << 20), offs[1]);
+}
+
+/// The OS and driver calls under mapDrm, in the order it makes them; every failure is injected in turn.
+const Fake = struct {
+    d: *const cuda.Driver = undefined,
+    step: usize = 0,
+    fail: usize = 0,
+    closed: usize = 0,
+    gems: usize = 0,
+    unmapped: usize = 0,
+    unregistered: usize = 0,
+    short: bool = false,
+    separate: bool = false,
+    fn next(f: *Fake) !void {
+        f.step += 1;
+        if (f.step == f.fail) return error.Injected;
+    }
+    fn openCard(f: *Fake) !c_int {
+        try f.next();
+        return 3;
+    }
+    fn create(f: *Fake, _: c_int, n: usize) !struct { handle: u32, size: usize } {
+        try f.next();
+        return .{ .handle = 7, .size = if (f.short) n - 1 else n };
+    }
+    fn offset(f: *Fake, _: c_int, _: u32) !u64 {
+        try f.next();
+        return 4096;
+    }
+    fn reserve(f: *Fake, _: usize) !usize {
+        try f.next();
+        return 0x10000;
+    }
+    fn ordinary(f: *Fake, base: usize, n: usize) !void {
+        try f.next();
+        try std.testing.expectEqual(@as(usize, 0x10000), base);
+        try std.testing.expectEqual(@as(usize, 4096), n);
+    }
+    fn display(f: *Fake, base: usize, _: usize, _: c_int, _: u64) !void {
+        try f.next();
